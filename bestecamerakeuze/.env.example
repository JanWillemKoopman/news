# Dataloket — zie README-dataloket.md voor de stappen.
# Zonder deze variabelen blijft het campagnedashboard gewoon werken; alleen het
# chattabblad toont dan welke er nog ontbreken.

# Inloggen en het querylog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# De READ-ONLY verbinding waarop de chat draait (rol dataloket_lezer, pooler poort 6543).
# Deze rol heeft uitsluitend SELECT op de v_-views.
DATAQUERY_DATABASE_URL=

# Claude API
ANTHROPIC_API_KEY=

# SCHRIJVENDE verbinding, uitsluitend voor de sync-job. Nooit dezelfde als DATAQUERY_DATABASE_URL.
SYNC_DATABASE_URL=

# Beschermt /api/sync tegen aanroepen van buiten. Genereer iets willekeurigs.
CRON_SECRET=

# Optioneel: andere sheet voor het bestaande campagnedashboard
# GOOGLE_SHEET_ID=
