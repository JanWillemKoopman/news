# Bewust wél in git: dit zijn uitsluitend NEXT_PUBLIC_-waarden, die per definitie in de
# client-bundle terechtkomen en dus niet geheim kunnen zijn. De Supabase publishable key is
# daar expliciet voor ontworpen; toegang wordt afgedwongen door RLS op camerakeuze.products
# (publiek leesbaar, schrijven alleen met de service_role key).
#
# Zo hoeft er in Vercel niets geconfigureerd te worden. Zet je ze daar later alsnog, dan
# winnen die — platform-variabelen gaan bij Next.js voor .env-bestanden.
#
# ECHTE secrets (service_role key, API-tokens) horen hier NOOIT in; die horen thuis in
# Vercel > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://pzpoptfljgrskebnuggt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ph-BpC3ftPyPMpbUzuM--A_2yxvz2Kq
