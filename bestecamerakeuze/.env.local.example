# Copy naar .env.local.
#
# De site draait OOK zonder deze variabelen: dan valt lib/products.ts terug op
# data/demo_cameras.csv, zodat `npm run dev` meteen werkt. Zet ze zodra je de
# CSV in Supabase hebt geladen.
#
# Zelfde Supabase-project als de rest van deze repo; camerakeuze-data leeft in
# het aparte `camerakeuze`-schema.
NEXT_PUBLIC_SUPABASE_URL=https://pzpoptfljgrskebnuggt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ph-BpC3ftPyPMpbUzuM--A_2yxvz2Kq

# Alleen nodig voor scripts/import-csv.ts (schrijft langs RLS heen).
# Server-only, NOOIT als NEXT_PUBLIC_ en nooit committen.
SUPABASE_SERVICE_ROLE_KEY=

# Canonieke basis-URL, gebruikt voor canonical-tags en absolute URL's in de JSON-LD op
# /vlogcameras. Zonder deze variabele valt lib/site.ts terug op https://bestecamerakeuze.nl.
# Zet hem op een preview-deploy zodat die naar zichzelf verwijst in plaats van naar productie.
NEXT_PUBLIC_SITE_URL=
